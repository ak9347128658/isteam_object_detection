# Copy this file to ".env" and fill in your real values (or pass them as
# container environment variables at launch — the launcher / queue supplies the
# per-video ones).
#
# Architecture 2 (no storage): the worker takes a video URL, processes it in a
# per-job temp dir, POSTs detections.json + detections.vtt INLINE to the
# callback, then deletes everything and exits. Nothing is stored.

# --- Per-video inputs (usually injected by the launcher, NOT committed) ------
# Direct http(s) link to the input video to process (one-shot mode).
# Video-host URLs also work (the worker uses yt-dlp).
VIDEO_URL=https://cdn.example.com/clips/abc.mp4
# URL that receives the POST callback (the iSteam backend) when processing finishes.
CALLBACK_URL=https://api.example.com/detections/callback
# The caller's own id, echoed back in the callback for correlation.
VIDEO_ID=abc-123
# Optional correlation id (auto-generated if omitted).
JOB_ID=

# --- Matching (Google Lens) --------------------------------------------------
# Google Lens needs a publicly fetchable image URL per crop. To honor "no
# storage" the worker uses an EPHEMERAL scratch bucket (option A): it uploads
# each crop, gets a short-lived presigned URL, matches, then DELETES the crop.
#
#   - Leave SCRATCH_BUCKET empty  -> matching is skipped; detections.json/.vtt
#                                    still contain products + timestamps.
#   - Set SCRATCH_BUCKET          -> matching runs, crops auto-deleted after.
#   - SKIP_MATCHING=true          -> force-skip matching (fully storage-free).
#   - SKIP_MATCHING=false         -> force matching (requires SCRATCH_BUCKET).
SKIP_MATCHING=
SCRATCH_BUCKET=
SCRATCH_REGION=us-east-1
SCRATCH_PREFIX=lens-scratch

# --- Poll mode (single box / EC2): python worker.py --poll -------------------
# Each SQS message body: { video_url, callback_url, video_id, job_id }
SQS_QUEUE_URL=
SQS_VISIBILITY=1800

# --- SerpApi (Google Lens visual/exact match) --------------------------------
SERPAPI_API_KEY=your_serpapi_key_here

# --- AWS credentials (ONLY needed for the optional ephemeral SCRATCH bucket) --
# Prefer an IAM task role / instance profile over static keys in production.
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1
