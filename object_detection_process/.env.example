# Copy this file to ".env" and fill in your real values (or pass them as
# container environment variables at launch — the launcher/SQS supplies the
# per-video ones).

# --- Per-video inputs (usually injected by the launcher, NOT committed) ------
# s3://bucket/key of the input video to process (one-shot mode).
VIDEO_S3_URI=s3://isteam-video-input/uploads/example.mp4
# URL that receives the POST callback when processing finishes.
CALLBACK_URL=https://api.example.com/detections/callback
# Optional correlation id (auto-generated if omitted).
JOB_ID=

# --- Output destination for detections.json / detections.vtt -----------------
OUTPUT_BUCKET=isteam-video-output
OUTPUT_PREFIX=detections
OUTPUT_REGION=us-east-1
# "true" -> public URL (bucket must allow ACLs); else a presigned URL is returned.
OUTPUT_PUBLIC=false

# --- Behavior ----------------------------------------------------------------
# "true" skips S3 crop upload + Google Lens matching (json/vtt still produced).
SKIP_MATCHING=false

# --- Poll mode (single GPU box / EC2): python worker.py --poll ---------------
SQS_QUEUE_URL=
SQS_VISIBILITY=1800

# --- SerpApi (Google Lens visual/exact match) --------------------------------
SERPAPI_API_KEY=your_serpapi_key_here

# --- AWS credentials (or use an IAM task role / instance profile) ------------
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1
