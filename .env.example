# Copy this file to ".env" and fill in your real values.
# The notebook loads it automatically with python-dotenv.

# --- SerpApi (Google Lens visual/exact match) - RECOMMENDED, this is the default ---
# Step-by-step: docs/serpapi-setup.md   |   Free tier available.
SERPAPI_API_KEY=your_serpapi_key_here

# --- AWS credentials for S3 upload/download ---
# You can also use an IAM role, AWS SSO, or ~/.aws/credentials instead of these.
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1
