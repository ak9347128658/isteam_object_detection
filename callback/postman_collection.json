{
  "info": {
    "name": "iSteam Object Detection - Callback",
    "description": "Test calls for the callback Lambda (behind API Gateway). Set the {{base_url}} and {{route}} collection variables, then Send. The Lambda just returns 200 and logs the payload to CloudWatch: /aws/lambda/isteam-object-detection-process-callback-lambda",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://f9u39iuej4.execute-api.us-east-1.amazonaws.com/default/isteam-object-detection-process-callback-lambda",
      "type": "string"
    },
    {
      "key": "route",
      "value": "/callback",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Callback - completed",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}{{route}}",
          "host": ["{{base_url}}{{route}}"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"video_id\": \"abc-123\",\n  \"job_id\": \"test-123\",\n  \"status\": \"completed\",\n  \"product_count\": 3,\n  \"detections_json\": { \"video\": { \"id\": \"abc-123\" }, \"products\": [] },\n  \"detections_vtt\": \"WEBVTT\\n\\n00:00:01.000 --> 00:00:03.000\\n[p0000] sneaker\\n\",\n  \"finished_at\": \"2026-09-07T10:02:00Z\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "description": "Simulates a successful detection callback."
      }
    },
    {
      "name": "Callback - failed",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}{{route}}",
          "host": ["{{base_url}}{{route}}"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"video_id\": \"abc-456\",\n  \"job_id\": \"test-456\",\n  \"status\": \"failed\",\n  \"error\": \"could not download video_url (HTTP 404)\",\n  \"finished_at\": \"2026-09-07T10:05:00Z\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "description": "Simulates a failed detection callback."
      }
    }
  ]
}
